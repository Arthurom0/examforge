# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more careful solutions, slower, pricier)
ANTHROPIC_EFFORT=high
# Where the SQLite db and uploaded PDFs live (relative to the repo root)
EXAMFORGE_DATA_DIR=data
# Tesseract language packs used for OCR on scanned PDFs
OCR_LANGS=fra+eng

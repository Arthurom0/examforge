# Copy this file to .env and fill in a key. Never commit .env. You can also set all of this in the app's Settings page.
# anthropic | openai | google | deepseek | xai | ollama
EXAMFORGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# Optional model overrides (defaults: claude-opus-5-5, gpt-6-astra, gemini-4-argon, deepseek-v4-pro, grok-4.7, qwen3:8b)
# ANTHROPIC_MODEL=claude-opus-5-5
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Claude only: low | medium | high | xhigh | max  (higher = more careful solutions, slower, pricier)
ANTHROPIC_EFFORT=high
# Where the SQLite db and uploaded PDFs live (relative to the repo root)
EXAMFORGE_DATA_DIR=data
# Tesseract language packs used for OCR on scanned PDFs
OCR_LANGS=fra+eng
